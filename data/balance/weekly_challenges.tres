[gd_resource type="Resource" script_class="WeeklyChallengePool" load_steps=13 format=3]

[ext_resource type="Script" path="res://src/sim/progression/weekly_challenge_pool.gd" id="1_pool"]
[ext_resource type="Script" path="res://src/sim/progression/weekly_challenge.gd" id="2_challenge"]

[sub_resource type="Resource" id="challenge_serve_1"]
script = ExtResource("2_challenge")
id = &"serve_a_busy_day"
kind = 0
text_template = "Serve {target} guests in one day"
base_target = 12
per_level = 4
reward_cash = 60

[sub_resource type="Resource" id="challenge_serve_2"]
