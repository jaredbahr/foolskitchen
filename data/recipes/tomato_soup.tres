[resource]
script = ExtResource("1_recipe")
view_model = ExtResource("view_model")
id = &"tomato_soup"
section = 0
display_name = "Tomato soup"
ingredients = Array[ExtResource("2_ingredient")]([ExtResource("ingredient_tomato"), ExtResource("ingredient_tomato"), ExtResource("ingredient_soup_stock")])
