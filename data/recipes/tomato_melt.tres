[gd_resource type="Resource" script_class="RecipeDef" load_steps=9 format=3]

[ext_resource type="Script" path="res://src/sim/content/recipe_def.gd" id="1_recipe"]
[ext_resource type="Script" path="res://src/sim/content/ingredient_def.gd" id="2_ingredient"]
[ext_resource type="Script" path="res://src/sim/content/recipe_step.gd" id="3_step"]
[ext_resource type="Resource" path="res://data/ingredients/bread.tres" id="ingredient_bread"]
[ext_resource type="Resource" path="res://data/ingredients/cheese.tres" id="ingredient_cheese"]
[ext_resource type="Resource" path="res://data/ingredients/tomato.tres" id="ingredient_tomato"]

[sub_resource type="Resource" id="Step_prep"]
script = ExtResource("3_step")
station_type = &"prep_counter"
duration_ticks = 25

[sub_resource type="Resource" id="Step_cook"]
script = ExtResource("3_step")
station_type = &"stove"
duration_ticks = 60

[resource]
script = ExtResource("1_recipe")
id = &"tomato_melt"
unlock_from = &"burger"
section = 1
display_name = "Tomato melt"
ingredients = Array[ExtResource("2_ingredient")]([ExtResource("ingredient_bread"), ExtResource("ingredient_bread"), ExtResource("ingredient_cheese"), ExtResource("ingredient_tomato")])
steps = Array[ExtResource("3_step")]([SubResource("Step_prep"), SubResource("Step_cook")])
base_quality = 0.58
standard_price = 10
unlock_tier = 1
unlock_level = 2
theme_tags = Array[StringName]([&"diner"])
