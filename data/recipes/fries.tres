[ext_resource type="Resource" path="res://data/ingredients/oil.tres" id="ingredient_oil"]
[ext_resource type="PackedScene" path="res://assets/kenney/food/fries.glb" id="view_model"]

[sub_resource type="Resource" id="Step_prep"]
script = ExtResource("3_step")
station_type = &"prep_counter"
duration_ticks = 20

[sub_resource type="Resource" id="Step_cook"]
script = ExtResource("3_step")
