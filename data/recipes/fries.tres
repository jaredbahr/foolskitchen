[gd_resource type="Resource" script_class="RecipeDef" load_steps=9 format=3]

[ext_resource type="Script" path="res://src/sim/content/recipe_def.gd" id="1_recipe"]
[ext_resource type="Script" path="res://src/sim/content/ingredient_def.gd" id="2_ingredient"]
[ext_resource type="Script" path="res://src/sim/content/recipe_step.gd" id="3_step"]
