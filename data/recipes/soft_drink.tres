[gd_resource type="Resource" script_class="RecipeDef" load_steps=6 format=3]

[ext_resource type="Script" path="res://src/sim/content/recipe_def.gd" id="1_recipe"]
[ext_resource type="Script" path="res://src/sim/content/ingredient_def.gd" id="2_ingredient"]
[ext_resource type="Script" path="res://src/sim/content/recipe_step.gd" id="3_step"]
[ext_resource type="Resource" path="res://data/ingredients/soda.tres" id="ingredient_soda"]

[sub_resource type="Resource" id="Step_make"]
script = ExtResource("3_step")
station_type = &"drinks_fridge"
duration_ticks = 15

[resource]
script = ExtResource("1_recipe")
id = &"soft_drink"
display_name = "Soft drink"
ingredients = Array[ExtResource("2_ingredient")]([ExtResource("ingredient_soda")])
steps = Array[ExtResource("3_step")]([SubResource("Step_make")])
base_quality = 0.5
standard_price = 3
unlock_tier = 1
unlock_level = 1
theme_tags = Array[StringName]([])
order_type = &"drinks"
