[gd_resource type="Resource" script_class="StaffCatalogue" load_steps=11 format=3]

[ext_resource type="Script" path="res://src/sim/staff/staff_catalogue.gd" id="1_catalogue"]
[ext_resource type="Script" path="res://src/sim/staff/staff_trait.gd" id="2_trait"]
[ext_resource type="Script" path="res://src/sim/staff/staff_member.gd" id="3_member"]

[sub_resource type="Resource" id="Trait_steady"]
script = ExtResource("2_trait")

[sub_resource type="Resource" id="Trait_quick"]
script = ExtResource("2_trait")
id = &"quick"
display_name = "Quick"
description = "Walks 15% faster."
walk_multiplier = 1.15

[sub_resource type="Resource" id="Trait_careful"]
script = ExtResource("2_trait")
id = &"careful"
display_name = "Careful"
description = "Works with care. No special bonus in this role."
role_descriptions = Dictionary[StringName, String]({
&"cook": "Adds 0.05 to the quality of meals they cook."
})
cook_quality_bonus = 0.05

[sub_resource type="Resource" id="Trait_cheerful"]
script = ExtResource("2_trait")
id = &"cheerful"
display_name = "Cheerful"
description = "Friendly manner. No special bonus in this role."
role_descriptions = Dictionary[StringName, String]({
&"server": "Guests they serve have 10% more patience for food."
})
food_patience_multiplier = 1.1

[sub_resource type="Resource" id="Trait_clumsy"]
script = ExtResource("2_trait")
id = &"clumsy"
display_name = "Clumsy"
description = "A little accident-prone. No special effect in this role."
role_descriptions = Dictionary[StringName, String]({
&"server": "More likely to spill a meal while carrying it."
})

[sub_resource type="Resource" id="Starter_cook"]
script = ExtResource("3_member")
id = &"starter_cook"
display_name = "Alex"
role = &"cook"

[sub_resource type="Resource" id="Starter_server"]
script = ExtResource("3_member")
id = &"starter_server"
display_name = "Sam"
role = &"server"

[resource]
script = ExtResource("1_catalogue")
traits = Array[ExtResource("2_trait")]([SubResource("Trait_steady"), SubResource("Trait_quick"), SubResource("Trait_careful"), SubResource("Trait_cheerful"), SubResource("Trait_clumsy")])
starters = Array[ExtResource("3_member")]([SubResource("Starter_cook"), SubResource("Starter_server")])
candidate_names = PackedStringArray("Robin", "Jamie", "Charlie", "Morgan", "Casey", "Taylor", "Jess", "Drew", "Lee", "Frankie", "Pat", "Blair")
