street_preset = "res://data/streets/promenade.tres"
price = 11500
daily_rent = 90
expansion_price = 6000
expanded_daily_rent = 125
expansion_west = 3
expansion_east = 3
expansion_north = 0
min_tier = 3
min_reputation = 3.8
guest_mix = Dictionary[StringName, float]({
&"family": 0.65,
&"regular": 0.35
})
tags = Array[StringName]([&"seaside"])
