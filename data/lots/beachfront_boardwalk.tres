[ext_resource type="Resource" path="res://data/layouts/lot_beachfront_boardwalk.tres" id="2_layout"]

[resource]
script = ExtResource("1_lot")
id = &"beachfront_boardwalk"
display_name = "Beachfront Boardwalk"
blurb = "A little shop between the beach and the boardwalk. Families stop for something cold, and the regulars know the way to the back patio."
