[resource]
script = ExtResource("1_lot")
id = &"seaside_cliff"
display_name = "Seaside Cliff"
blurb = "A white cottage at the top of the cliff path, every seat out on the terrace over the sea. Walkers come up from the car park, and the catch comes in fresh each morning."
base_layout = ExtResource("2_layout")
legacy_layouts = Array[ExtResource("4_layout_script")]([ExtResource("3_legacy")])
street_preset = "res://data/streets/cliff.tres"
price = 18000
daily_rent = 140
expansion_price = 9000
expanded_daily_rent = 190
expansion_west = 4
expansion_east = 0
expansion_north = 2
min_tier = 3
min_reputation = 4.2
guest_mix = Dictionary[StringName, float]({
&"family": 0.45,
&"foodie": 0.4,
&"regular": 0.15
})
upstairs_allowed = false
tags = Array[StringName]([&"seaside"])
