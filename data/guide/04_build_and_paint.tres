[gd_resource type="Resource" script_class="GuidePage" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/ui/guide_page.gd" id="1_page"]

[resource]
script = ExtResource("1_page")
title = "Build and paint"
body = "Build is where you shape the restaurant. Place walls, rooms, tables, chairs, stations, storage and decor. The preview marks where workers stand and warns when guests or staff may not be able to reach a seat or station. Treat those warnings as a useful layout check before opening. Structural edits are for a closed restaurant. Furniture and decor can be adjusted during service, with paths checked again.\n\nPaint lets you try different finishes and curated colours on walls, floors and compatible furniture. Recolouring is free, so you can experiment without spending the restaurant's cash. Floor patterns and wall finishes unlock as your owner progresses. Laying some floor types costs money, while the starting wide planks are free. Keep guest routes open and leave enough room around stations. A lovely room still needs to work when orders start arriving."
