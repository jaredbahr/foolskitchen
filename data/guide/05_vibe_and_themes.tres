[gd_resource type="Resource" script_class="GuidePage" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/ui/guide_page.gd" id="1_page"]

[resource]
script = ExtResource("1_page")
title = "Vibe and themes"
body = "Your restaurant's vibe comes from what guests encounter around their seats. That includes decor, lighting, colour, furnishings, music and the food you serve. The Vibe readout helps show which ingredients are helping. Repeating one decoration has diminishing returns. Using different kinds adds variety. Crowding can work against comfort, so leave enough breathing room for guests and staff.\n\nA theme is inferred from the shop's actual choices, including tagged furniture and variants, paint and the current menu. The strongest theme can influence who visits and how well the place suits its audience. You do not pick a theme from a list or need to match every object. Build the room you like, then use the readout to see what concept your choices communicate. A few changes to decor, colours or dishes can shift the balance."
