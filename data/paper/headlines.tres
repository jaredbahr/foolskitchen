[gd_resource type="Resource" script_class="MorningPaperHeadlines" format=3]

[ext_resource type="Script" path="res://src/ui/morning_paper_headlines.gd" id="1_headlines"]

[resource]
script = ExtResource("1_headlines")
groups = Dictionary[StringName, PackedStringArray]({
&"first_day": PackedStringArray("New kitchen opens and the neighborhood smells lunch", "Fresh aprons spotted on the high street", "Local spoons report for first shift", "Chairs tucked in, stoves at the ready", "A new shop puts lunch on the map"),
&"record": PackedStringArray("Kitchen sets a record and {dish} asks for a trophy", "A new shop record! Extra room needed on the fridge", "Local kitchen breaks a record without breaking a plate", "The shop's best just got better", "New record gives the cook something to stir about", "Records tumble and the tea towel takes a lap of honor", "{dish} helps the kitchen set a new best"),
&"loss": PackedStringArray("Till ends the day at {cash} and the calculator asks for tea", "A {cash} day gives the books something to chew on", "Kitchen reports {cash}. Tomorrow gets a clean plate", "Shop's books finish at {cash} and the pencil gets another go"),
&"walkouts": PackedStringArray("{guests} guests walk and the front door gets a workout", "{guests} leave before lunch, taking their appetites with them", "{guests} walkouts keep the bell by the door busy", "Line loses {guests} and lunch goes on without them"),
&"review": PackedStringArray("Five stars land in the kitchen without a reservation", "Local diner awards five stars and the cook rereads the review", "A five-star review makes room on the fridge", "Five stars for lunch and a plate without crumbs"),
&"quiet": PackedStringArray("The door rests after a quiet shift with {guests} served", "The shop serves {guests} and the tables enjoy the elbow room", "Quiet tables leave plenty of time to polish the forks", "{dish} makes for a quiet day at the shop"),
&"inspection": PackedStringArray("Inspector files a grade and the kitchen has news for the fridge", "Inspection results are in and the clipboard has left the building", "The kitchen gets its grade and gets back to chopping", "Local kitchen sees an inspection grade come through the door"),
&"tier": PackedStringArray("The shop moves up a tier and the doormat gets an upgrade", "Up a tier! The cook irons the good apron", "Local kitchen climbs a tier and the menu stands a little taller", "Big news on the high street: the shop goes up a tier"),
&"level_up": PackedStringArray("Owner levels up and the catalog gets thicker", "New level, new toys: the owner has some shopping to do", "The owner grows into the apron and new things arrive", "A level up for the owner, and the catalog clears its throat"),
&"regular": PackedStringArray("A familiar face asks for \"the usual\" for the first time", "Someone new calls the shop \"my place\" and means it", "The shop gains a regular and the counter learns a name", "First-name terms: a new regular claims a favorite chair"),
&"full_house": PackedStringArray("Every seat taken: {guests} served and a queue out the door", "Full house! {guests} fed and the chairs barely cooled", "The place to be: {guests} served and more still waiting", "Standing room only as {guests} guests tuck in"),
&"brief_shutterbug": PackedStringArray("A guest photographed every dish yesterday. Their phone needs a nap.", "Yesterday's lunch is now famous in at least one photo album.", "One guest took more pictures than bites yesterday. Both were good."),
&"brief_chatterbox": PackedStringArray("A guest told the dining room their whole life story yesterday. Several chapters.", "One guest stayed for coffee and a chat yesterday. A very long chat.", "Yesterday a guest made three new friends between courses."),
&"brief_lunch_break": PackedStringArray("An office worker ate, paid and sprinted back to their desk yesterday.", "A guest finished lunch with eleven minutes to spare yesterday. A personal best.", "Yesterday's fastest lunch: soup to sidewalk in under twenty minutes.")
})
