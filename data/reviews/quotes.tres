[gd_resource type="Resource" script_class="ReviewQuotes" format=3]

[ext_resource type="Script" path="res://src/sim/reviews/review_quotes.gd" id="1_quotes"]

[resource]
script = ExtResource("1_quotes")
groups = Dictionary[StringName, PackedStringArray]({
&"slow_seating": PackedStringArray("Found a seat eventually. Made friends with the queue.", "The line had plenty of time to admire the decor.", "A table opened just as my feet gave up.", "The queue was longer than my shopping list.", "I got to know the front door very well.", "A chair would have made the wait easier."),
&"slow_food": PackedStringArray("I aged a little waiting for lunch. Worth a bite, though.", "The kitchen took the scenic route to my table.", "My stomach started keeping its own clock.", "Good food, once it found me.", "I finished a whole daydream before dinner arrived.", "I had time to plan tomorrow's lunch while waiting."),
&"great_value": PackedStringArray("That was a lovely meal for the price.", "My wallet left as happy as I did.", "A bargain worth coming back for.", "Good food without a scary bill.", "I checked the bill twice. What a deal.", "Plenty of cheer for a small price."),
&"too_pricey": PackedStringArray("Delicious, but my wallet wants a word.", "The bill had more ambition than I did.", "Lovely food. A little steep for lunch.", "I may need to save up for seconds.", "My purse is still recovering.", "Tasty, though the price raised an eyebrow."),
&"dirty_floor": PackedStringArray("The food shone brighter than the floor.", "A little mop magic would help this place.", "The floor had a story to tell.", "Great meal; the floor could use a fresh start.", "I watched my step between bites.", "A tidy floor would make this even nicer."),
&"lovely_place": PackedStringArray("A cosy spot for a cheerful meal.", "The whole visit made my day.", "Warm room, good food, happy me.", "I came for lunch and left smiling.", "Everything clicked today. I'll be back.", "A sweet little place to spend an hour."),
&"never_served": PackedStringArray("I came hungry and left hungry.", "The menu sounded good from the doorway.", "Maybe next time a plate will find me.", "I waited, but lunch had other plans.", "I hope the kitchen and I meet next time.", "The visit ended before the meal began."),
&"no_restroom": PackedStringArray("Lovely meal, but I couldn't find a restroom.", "A restroom would make a long lunch easier.", "I would have stayed longer with a restroom nearby.", "Good food. The place just needs a restroom.", "I wish there had been somewhere to freshen up.", "Nice spot, but the restroom was always busy.")
})
