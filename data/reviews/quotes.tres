[gd_resource type="Resource" script_class="ReviewQuotes" format=3]

[ext_resource type="Script" path="res://src/sim/reviews/review_quotes.gd" id="1_quotes"]

[resource]
script = ExtResource("1_quotes")
groups = Dictionary[StringName, PackedStringArray]({
&"slow_seating": PackedStringArray("Found a seat eventually. Made friends with the queue.", "The line had plenty of time to admire the decor.", "A table opened just as my feet gave up.", "The queue was longer than my shopping list.", "I got to know the front door very well.", "A chair would have made the wait easier."),
&"slow_food": PackedStringArray("I aged a little waiting for lunch. Worth a bite, though.", "The kitchen took the scenic route to my table.", "My stomach started keeping its own clock.", "Good food, once it found me.", "I finished a whole daydream before dinner arrived.", "I had time to plan tomorrow's lunch while waiting."),
&"great_value": PackedStringArray("That was a lovely meal for the price.", "My wallet left as happy as I did.", "A bargain worth coming back for.", "Good food without a scary bill.", "I checked the bill twice. What a deal.", "Plenty of cheer for a small price."),
&"too_pricey": PackedStringArray("Delicious, but my wallet wants a word.", "The bill had more ambition than I did.", "Lovely food. A little steep for lunch.", "I may need to save up for seconds.", "My purse is still recovering.", "Tasty, though the price raised an eyebrow."),
&"sticky_floor": PackedStringArray("Lovely lunch. The floor tried to keep my shoes.", "A mop would make the trip to my table smoother.", "Good food; a little less stick underfoot, please."),
&"dirty_floor": PackedStringArray("The food shone brighter than the floor.", "A little mop magic would help this place.", "The floor had a story to tell.", "Great meal; the floor could use a fresh start.", "I watched my step between bites.", "A tidy floor would make this even nicer."),
&"lovely_place": PackedStringArray("A cozy spot for a cheerful meal.", "The whole visit made my day.", "Warm room, good food, happy me.", "I came for lunch and left smiling.", "Everything clicked today. I'll be back.", "A sweet little place to spend an hour."),
&"never_served": PackedStringArray("I came hungry and left hungry.", "The menu sounded good from the doorway.", "Maybe next time a plate will find me.", "I waited, but lunch had other plans.", "I hope the kitchen and I meet next time.", "The visit ended before the meal began."),
&"no_restroom": PackedStringArray("Lovely meal, but I couldn't find a restroom.", "A restroom would make a long lunch easier.", "I would have stayed longer with a restroom nearby.", "Good food. The place just needs a restroom.", "I wish there had been somewhere to freshen up.", "A restroom would make this place perfect."),
&"restroom_busy": PackedStringArray("Nice spot, but the restroom was always busy.", "I waited for the restroom longer than for my food.", "One restroom isn't enough for a place this busy.", "Lovely meal; the restroom queue, less so.", "The restroom was taken every time I tried.", "More restrooms, please. The food was great."),
&"comfortable_wait": PackedStringArray("A seat on the bench made the wait easy.", "Nice to rest my feet before a table opened.", "The waiting bench was a thoughtful touch.", "A comfortable spot to wait for lunch."),
&"petted_cat": PackedStringArray("The shop cat let me pet it while I waited. Best part of lunch.", "Petted the resident cat and forgot all about the wait.", "A purring cat and a warm meal. I'll be back."),
&"critic_good": PackedStringArray("Confident cooking and prompt service. A table worth booking.", "Every plate arrived just when it should. I will be telling people.", "Honest, careful food in a room that cares. Highly recommended."),
&"critic_bad": PackedStringArray("Promising ideas, but the meal never quite came together.", "I waited, I chewed, and I was left unconvinced.", "A kitchen with potential. Today it stayed well hidden."),
&"signature_dish": PackedStringArray("The house dish earns its place on the menu.", "The kitchen's signature gets deserved attention.", "A house favorite worth sharing.", "The signature plate gives this café character.", "The named house dish has earned its reputation."),
&"photo_happy": PackedStringArray("Took forty photos of my soup. Ate it warm anyway.", "Every plate was camera-ready. So was I, eventually.", "My followers have now seen this pie from every angle.", "The lighting was perfect. The food was even better.", "I photographed dessert twice. It deserved a third.", "My phone ate first. Then I did. We both loved it."),
&"chatty_happy": PackedStringArray("Told the server my whole week. They laughed in all the right places.", "Stayed for one coffee and three life stories.", "Lovely food, lovelier chat. I may have overstayed.", "Made friends with the next table. And the one after that.", "I talked through two courses and it all still tasted great.", "The staff now know my cousin's wedding plans. Worth it."),
&"quick_lunch": PackedStringArray("In and out before my boss noticed. A delicious getaway.", "Lunch arrived faster than my next meeting.", "Ate well and still had time to sit in the sun.", "Quick, tasty, and back at my desk with crumbs to spare.", "My lunch hour felt like a lunch hour and a half.", "Fast food that tastes slow-cooked. Top marks."),
&"regular_happy": PackedStringArray("Same table, same smile, same great lunch. Never change.", "They know my order before I sit down. That's a good place.", "My usual was as good as usual. That's high praise.", "Twelfth visit this month. Don't tell my doctor.", "Like coming home, if home had better soup.", "Another lovely lunch. The chair knows my shape by now."),
&"student_happy": PackedStringArray("Fed me well and left me money for books. Okay, for snacks.", "Best meal of my week, and my week included free pizza.", "Studied an hour at the table and nobody rushed me. Legends.", "Cheap, filling, and nobody judged my hoodie.", "Ate like a grown-up. Felt like one, too, briefly.", "I'd write an essay about this lunch, but I have three due."),
&"foodie_happy": PackedStringArray("The seasoning was confident. The texture was honest. I'm moved.", "I tasted every element. Then I tasted them again. Bravo.", "A plate with a point of view. I'll be thinking about that sauce.", "Simple food, done properly. Rarer than it should be.", "I took notes. My notes say: come back.", "This kitchen tastes as it goes, and it shows."),
&"family_happy": PackedStringArray("The kids ate their greens. I don't know how. I'm not asking.", "Nobody cried, nobody spilled. A family miracle.", "Room for all of us and a high chair. Next time we bring Grandma.", "Four plates, all cleaned. One of them by the dog, later.", "The little one called it \"the best food ever.\" Twice.", "Fed the whole crew without a single meltdown. Mine included."),
&"tourist_happy": PackedStringArray("Best meal of the whole trip. Don't tell the hotel buffet.", "Found this place by accident. Best accident of our vacation.", "Sending a postcard of this lunch to everyone back home.", "Ate like a local. Got lost on the way back like a tourist.", "If you visit one place in town, make it this one.", "We came for the views and stayed for the soup."),
&"office_happy": PackedStringArray("Best part of my workday, and it wasn't even close.", "Went back to the office in a good mood. Coworkers were alarmed.", "Took the whole team here. Morale is up. HR wants the address.", "A proper lunch break. I almost forgot my inbox existed.", "Ate well and still made my one-thirty. A perfect weekday.", "Beats the break room fridge, including my own sad sandwich.")
})
