[gd_resource type="Resource" script_class="ServiceEventDef" load_steps=6 format=3]

[ext_resource type="Script" path="res://src/sim/events/service_event_def.gd" id="1_def"]
[ext_resource type="Script" path="res://src/sim/events/service_event_choice.gd" id="2_choice"]

[sub_resource type="Resource" id="Choice_1"]
script = ExtResource("2_choice")
label = "Share it everywhere"
result = "It did the rounds. A wave of curious faces rolled in."
day_arrivals_percent = 10
risk_percent = 25
risk_review_stars = 2
risk_result = "Someone read past the photos: \"Everyone else waited ages.\" Two stars. Still busy, though."

[sub_resource type="Resource" id="Choice_2"]
script = ExtResource("2_choice")
label = "Frame it by the till"
result = "Framed and hung. A guest read it, nodded, and left five stars to match."
cash = -8
review_stars = 5

[sub_resource type="Resource" id="Choice_3"]
script = ExtResource("2_choice")
label = "Never read reviews"
result = "You didn't read it. Apparently it was nice."

[resource]
script = ExtResource("1_def")
id = &"blogger_review"
title = "The review is out"
text = "The food blogger's review went up this morning. Eleven photos of the food, one of you mid-blink."
icon = &"reputation"
cooldown_days = 5
follow_up_only = true
choices = Array[ExtResource("2_choice")]([SubResource("Choice_1"), SubResource("Choice_2"), SubResource("Choice_3")])
