[gd_resource type="Resource" script_class="ServiceEventDef" load_steps=5 format=3]

[ext_resource type="Script" path="res://src/sim/events/service_event_def.gd" id="1_def"]
[ext_resource type="Script" path="res://src/sim/events/service_event_choice.gd" id="2_choice"]

[sub_resource type="Resource" id="Choice_1"]
script = ExtResource("2_choice")
label = "Drink's on the house"
result = "A free drink and a real apology. Five stars and one damp chair."
cash = -4
review_stars = 5

[sub_resource type="Resource" id="Choice_2"]
script = ExtResource("2_choice")
label = "Charge as usual"
result = "They paid. Damply."
cash = 4
risk_percent = 40
risk_review_stars = 2
risk_result = "They paid, then wrote a review about their trousers. Two stars."

[resource]
script = ExtResource("1_def")
id = &"spilled_drink"
title = "Spilled drink"
text = "A full glass goes flying across table four. Some of it lands on a guest. Most of it lands on their trousers."
icon = &"warning"
cooldown_days = 3
choices = Array[ExtResource("2_choice")]([SubResource("Choice_1"), SubResource("Choice_2")])
