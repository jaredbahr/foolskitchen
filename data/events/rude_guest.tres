[gd_resource type="Resource" script_class="ServiceEventDef" load_steps=5 format=3]

[ext_resource type="Script" path="res://src/sim/events/service_event_def.gd" id="1_def"]
[ext_resource type="Script" path="res://src/sim/events/service_event_choice.gd" id="2_choice"]

[sub_resource type="Resource" id="Choice_1"]
script = ExtResource("2_choice")
label = "Side with the guest"
result = "You refunded the meal and apologised twice. The guest beamed. {staff} did not."
cash = -12
review_stars = 4
staff_mood = -1

[sub_resource type="Resource" id="Choice_2"]
script = ExtResource("2_choice")
label = "Back {staff} up"
result = "The guest stormed out and wrote one star from the pavement. {staff} looked ten feet tall."
review_stars = 1
staff_mood = 1

[resource]
script = ExtResource("1_def")
id = &"rude_guest"
title = "A guest with opinions"
text = "A guest is loudly telling {staff} the food is \"not how my grandma made it\". {staff} has never met their grandma."
icon = &"warning"
requires = Array[StringName]([&"staff"])
cooldown_days = 6
choices = Array[ExtResource("2_choice")]([SubResource("Choice_1"), SubResource("Choice_2")])
