[gd_resource type="Resource" script_class="ServiceEventDef" load_steps=6 format=3]

[ext_resource type="Script" path="res://src/sim/events/service_event_def.gd" id="1_def"]
[ext_resource type="Script" path="res://src/sim/events/service_event_choice.gd" id="2_choice"]

[sub_resource type="Resource" id="Choice_1"]
script = ExtResource("2_choice")
label = "Free dessert"
result = "{regular} beamed at the candle. Five stars and a hug nobody asked for."
cash = -5
review_stars = 5

[sub_resource type="Resource" id="Choice_2"]
script = ExtResource("2_choice")
label = "Get the team to sing"
result = "The team sang. {regular} has asked them never to do that again. Two stars."
review_stars = 2
risk_percent = 50
risk_review_stars = 5
risk_result = "The team sang, badly, with feeling. {regular} cried a little. Five stars."

[sub_resource type="Resource" id="Choice_3"]
script = ExtResource("2_choice")
label = "Wish them well"
result = "{regular} said thanks. They seemed fine about it. Mostly."

[resource]
script = ExtResource("1_def")
id = &"regular_birthday"
title = "A regular's birthday"
text = "{regular} mentions, twice, that it's their birthday today."
icon = &"reputation"
requires = Array[StringName]([&"regulars"])
cooldown_days = 7
choices = Array[ExtResource("2_choice")]([SubResource("Choice_1"), SubResource("Choice_2"), SubResource("Choice_3")])
