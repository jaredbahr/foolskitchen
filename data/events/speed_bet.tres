[gd_resource type="Resource" script_class="ServiceEventDef" load_steps=5 format=3]

[ext_resource type="Script" path="res://src/sim/events/service_event_def.gd" id="1_def"]
[ext_resource type="Script" path="res://src/sim/events/service_event_choice.gd" id="2_choice"]

[sub_resource type="Resource" id="Choice_1"]
script = ExtResource("2_choice")
label = "You're on"
result = "Plated in four minutes flat. They paid double and asked for the chef's autograph."
cash = 25
guest_patience_seconds = -10
risk_percent = 50
risk_cash = -50
risk_result = "Five minutes and nine seconds. Dinner's on the house, and everyone else waited too."

[sub_resource type="Resource" id="Choice_2"]
script = ExtResource("2_choice")
label = "We don't gamble"
result = "They paid the usual price. And yawned."

[resource]
script = ExtResource("1_def")
id = &"speed_bet"
title = "Double or nothing"
text = "A guest bets their bill the kitchen can't plate a dish in five minutes. Win, they pay double. Lose, it's on the house."
icon = &"chef"
cooldown_days = 6
choices = Array[ExtResource("2_choice")]([SubResource("Choice_1"), SubResource("Choice_2")])
