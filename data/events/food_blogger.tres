[gd_resource type="Resource" script_class="ServiceEventDef" load_steps=5 format=3]

[ext_resource type="Script" path="res://src/sim/events/service_event_def.gd" id="1_def"]
[ext_resource type="Script" path="res://src/sim/events/service_event_choice.gd" id="2_choice"]

[sub_resource type="Resource" id="Choice_1"]
script = ExtResource("2_choice")
label = "Seat them now"
result = "They skipped the queue, ate everything and posted it all. Expect curious faces tomorrow."
guest_patience_seconds = -15
tomorrow_arrivals_percent = 8

[sub_resource type="Resource" id="Choice_2"]
script = ExtResource("2_choice")
label = "They can queue"
result = "They queued like everyone else, and lived."
risk_percent = 30
risk_review_stars = 2
risk_result = "They queued, then told forty thousand people about queuing. Two stars."

[resource]
script = ExtResource("1_def")
id = &"food_blogger"
title = "Food blogger at the door"
text = "Someone is photographing your menu from three angles. \"I have forty thousand followers,\" they tell no one in particular."
icon = &"reputation"
cooldown_days = 5
choices = Array[ExtResource("2_choice")]([SubResource("Choice_1"), SubResource("Choice_2")])
