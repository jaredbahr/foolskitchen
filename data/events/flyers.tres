[gd_resource type="Resource" script_class="ServiceEventDef" load_steps=6 format=3]

[ext_resource type="Script" path="res://src/sim/events/service_event_def.gd" id="1_def"]
[ext_resource type="Script" path="res://src/sim/events/service_event_choice.gd" id="2_choice"]

[sub_resource type="Resource" id="Choice_1"]
script = ExtResource("2_choice")
label = "A week of flyers"
result = "Flyers went up on every lamppost in town. Expect a few more faces all week."
cash = -40
tomorrow_arrivals_percent = 8
tomorrow_days = 5

[sub_resource type="Resource" id="Choice_2"]
script = ExtResource("2_choice")
label = "Just a small stack"
result = "A modest stack of flyers. A modest bump for a couple of days, probably."
cash = -15
tomorrow_arrivals_percent = 8
tomorrow_days = 2

[sub_resource type="Resource" id="Choice_3"]
script = ExtResource("2_choice")
label = "No, thanks"
result = "They shrugged and offered the shop next door the same deal."

[resource]
script = ExtResource("1_def")
id = &"flyers"
title = "Flyers for hire"
text = "A teenager offers to hand out flyers all week. Their rate is $40 and a free lunch. They seem very firm about the lunch."
icon = &"information"
cooldown_days = 10
choices = Array[ExtResource("2_choice")]([SubResource("Choice_1"), SubResource("Choice_2"), SubResource("Choice_3")])
