[gd_resource type="Resource" script_class="ServiceEventDef" load_steps=5 format=3]

[ext_resource type="Script" path="res://src/sim/events/service_event_def.gd" id="1_def"]
[ext_resource type="Script" path="res://src/sim/events/service_event_choice.gd" id="2_choice"]

[sub_resource type="Resource" id="Choice_1"]
script = ExtResource("2_choice")
label = "Free fries, big smile"
result = "She ate the fries and decided the smell was \"actually quite nice\"."
cash = -6
review_stars = 4

[sub_resource type="Resource" id="Choice_2"]
script = ExtResource("2_choice")
label = "Close the door politely"
result = "She left. She'll be back. They always come back."
risk_percent = 30
risk_review_stars = 1
risk_result = "She left a one-star review: \"Smells of ambition.\""

[resource]
script = ExtResource("1_def")
id = &"neighbour_complaint"
title = "The neighbour again"
text = "The neighbour is at the door about \"the smell\". It's food. You're a restaurant. Still, she has a clipboard."
icon = &"warning"
cooldown_days = 6
choices = Array[ExtResource("2_choice")]([SubResource("Choice_1"), SubResource("Choice_2")])
