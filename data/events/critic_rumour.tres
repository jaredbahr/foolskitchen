[resource]
script = ExtResource("1_def")
id = &"critic_rumour"
title = "Critic rumour"
text = "Word on the street: a critic is in the area. Possibly. The word on the street is not always reliable."
icon = &"information"
min_tier = 2
cooldown_days = 7
choices = Array[ExtResource("2_choice")]([SubResource("Choice_1"), SubResource("Choice_2")])
