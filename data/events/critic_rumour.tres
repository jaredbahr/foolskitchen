[ext_resource type="Script" path="res://src/sim/events/service_event_choice.gd" id="2_choice"]

[sub_resource type="Resource" id="Choice_1"]
script = ExtResource("2_choice")
label = "Spruce the place up"
result = "Fresh flowers, a mop and a stern word with the cutlery. Nobody came. It looks lovely though."
cash = -10
clean_spots = true

[sub_resource type="Resource" id="Choice_2"]
script = ExtResource("2_choice")
label = "Ignore it"
result = "Just a rumour. It usually is."
risk_percent = 25
risk_review_stars = 2
