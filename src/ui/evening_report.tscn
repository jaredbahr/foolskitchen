[node name="EveningReport" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")
script = ExtResource("1_script")

[node name="Panel" type="PanelContainer" parent="."]
layout_mode = 0
anchor_left = 0.12
anchor_right = 0.88
anchor_bottom = 0.97
offset_top = 112.0
grow_horizontal = 2
grow_vertical = 2

[node name="Column" type="VBoxContainer" parent="Panel"]
layout_mode = 2
